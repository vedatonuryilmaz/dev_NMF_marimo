{
  "id": "capability-build",
  "version": "1.0.0",
  "objective": "Implement minimum code changes that satisfy quality gates.",
  "permissions": [
    "allow_file_io",
    "allow_shell_exec"
  ],
  "inputs": [
    {
      "file": "TASK.md",
      "critical": true
    },
    {
      "file": "SPEC_CONTRACT.json",
      "critical": true
    }
  ],
  "outputs": [
    {
      "file": "nmf_marimo.py",
      "validation_gate": "gate.marimo-check"
    }
  ],
  "failure_routing": {
    "missing_input": "BLOCK_AND_REQUEST_INFO",
    "gate_failure": "REVERT_TO_PREVIOUS_ROLE"
  }
}
